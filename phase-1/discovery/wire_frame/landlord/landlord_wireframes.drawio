        <mxCell id="dco_s1" value="&lt;b&gt;1. CHỐT SỐ ĐIỆN NƯỚC CUỐI CÙNG (OCR)&lt;/b&gt;&lt;br&gt;• Điện cuối: &lt;b&gt;1,450&lt;/b&gt; kWh (Tiêu thụ: 50 kWh = 175,000 đ)&lt;br&gt;• Nước cuối: &lt;b&gt;60&lt;/b&gt; m3 (Tiêu thụ: 4 m3 = 40,000 đ)" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#f8f9fa;strokeColor=#dee2e6;align=left;spacingLeft=14;fontSize=11;lineHeight=1.5;" vertex="1" parent="1">
