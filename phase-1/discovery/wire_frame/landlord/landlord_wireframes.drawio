        <mxCell id="msg_1" value="&lt;b&gt;Thái Bảo (Khách thuê):&lt;/b&gt; Dạ chú ơi, cho con hỏi số điện tháng này chốt bao nhiêu vậy ạ?" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#ced4da;align=left;spacingLeft=14;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="155" width="500" height="40" as="geometry" />
        </mxCell>
        <mxCell id="msg_2" value="&lt;b&gt;Chủ trọ (Bạn):&lt;/b&gt; Chú vừa chốt số công tơ xong nè con, để bot gửi hóa đơn qua VietQR ngay nhé." style="html=1;whiteSpace=wrap;rounded=1;fillColor=#e7f5ff;strokeColor=#a5d8ff;align=left;spacingLeft=14;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="890" y="210" width="520" height="40" as="geometry" />
        </mxCell>
        <mxCell id="card_inv" value="&lt;div style=&quot;font-weight:bold;color:#1971c2;font-size:13px;&quot;&gt;🤖 BOT RENTIFY: THẺ HÓA ĐƠN TIỀN NHÀ THÁNG 08/2026&lt;/div&gt;&lt;div style=&quot;font-size:12px;margin-top:6px;line-height:1.5;&quot;&gt;• Tiền phòng: &lt;b&gt;3,500,000 đ&lt;/b&gt; &amp;nbsp;|&amp;nbsp; Điện (100 kWh): &lt;b&gt;350,000 đ&lt;/b&gt; &amp;nbsp;|&amp;nbsp; Nước (8 m3): &lt;b&gt;80,000 đ&lt;/b&gt;&lt;br&gt;• Phí rác &amp; mạng: &lt;b&gt;100,000 đ&lt;/b&gt; &amp;nbsp;--→&amp;nbsp; &lt;b&gt;TỔNG TIỀN: 4,030,000 VNĐ&lt;/b&gt;&lt;br&gt;• Hạn đóng: &lt;b&gt;10/09/2026&lt;/b&gt; &amp;nbsp;|&amp;nbsp; Trạng thái: &lt;span style=&quot;color:#d63384;font-weight:bold;&quot;&gt;CHƯA THANH TOÁN&lt;/span&gt;&lt;br&gt;&lt;/div&gt;&lt;br&gt;&lt;div style=&quot;background:#ffffff;padding:8px;border:1px solid #ced4da;border-radius:6px;display:inline-block;&quot;&gt;&lt;b&gt;[ HÌNH ẢNH MÃ VIETQR ĐỘNG ĐỊNH DANH: 4,030,000 đ ]&lt;/b&gt; (Quét bằng app ngân hàng bất kỳ)&lt;/div&gt;&lt;br&gt;&lt;br&gt;[ Xem chi tiết bảng kê ] &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;[ V Xác nhận đã thu tiền mặt (D29) ]&lt;/b&gt;" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#f8f9fa;strokeColor=#339af0;strokeWidth=2;align=left;spacingLeft=16;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="410" y="270" width="620" height="190" as="geometry" />
        </mxCell>
        <mxCell id="msg_3" value="&lt;b&gt;Thái Bảo (Khách thuê):&lt;/b&gt; @issue Vòi sen trong nhà tắm bị rò rỉ nước nhờ chú gọi thợ qua sửa giúp con với ạ!" style="html=1;whiteSpace=wrap;rounded=1;fillColor=#ffffff;strokeColor=#ced4da;align=left;spacingLeft=14;fontSize=12;" vertex="1" parent="1">
